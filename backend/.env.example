# Copy this file to /opt/qtw/backend.env on the DigitalOcean droplet.
# Keep real secrets only on the droplet or in GitLab CI/CD variables.

APP_ENV=production
QR_BASE_URL=https://qtw.quip.network
ASSETS_API_BASE_URL=https://asset-tracker.quip.network
GUROBI_IN_RACE=0
MTM_TICK_S=10
VALUATION_SNAPSHOT_INTERVAL_S=60
# Per-agent QPU admission cap: 8 admitted solves per rolling 10 minutes (the decided
# booth value, also the code default). Lower only to conserve Leap quota.
QPU_BUDGET_MAX_ATTEMPTS=8
QPU_BUDGET_WINDOW_S=600

# Required production secrets:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# DWAVE_API_TOKEN=<Leap token>

# Optional offline container smoke test override:
# MARKET_DATA_SOURCE=synthetic

# Optional Proton SMTP sender. Keep the real token only in the droplet env file.
# SMTP is active only when SMTP_ENABLED=1, even if the credential vars are set.
# SMTP_ENABLED=1
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
# SMTP_USERNAME=qtw@quip.network
# SMTP_PASSWORD=<Proton SMTP token>
# SMTP_FROM=Quip Network <qtw@quip.network>
# SMTP_TIMEOUT_S=10
