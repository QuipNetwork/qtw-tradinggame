# Copy this file to /opt/qtw/backend.env on the DigitalOcean droplet.
# Keep real secrets only on the droplet or in GitLab CI/CD variables.

APP_ENV=production
QR_BASE_URL=https://qtw.quip.network
ASSETS_API_BASE_URL=https://asset-tracker.quip.network
GUROBI_IN_RACE=0
MTM_TICK_S=10
VALUATION_SNAPSHOT_INTERVAL_S=60
# Per-agent QPU admission cap: 8 admitted solves per rolling 10 minutes (the decided
# booth value, also the code default). Lower only to conserve Leap quota.
QPU_BUDGET_MAX_ATTEMPTS=8
QPU_BUDGET_WINDOW_S=600

# Signup anti-abuse. The per-IP cap is OFF by default (0): a conference shares one NAT
# IP, so per-IP would throttle the whole venue, not abuse. The booth-wide hourly ceiling
# stays on as the backstop. Set SIGNUP_RATE_PER_IP > 0 to re-enable the per-IP cap.
# SIGNUP_RATE_PER_IP=0
# SIGNUP_RATE_GLOBAL_PER_HOUR=300

# Required production secrets:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres
# DWAVE_API_TOKEN=<Leap token>

# Optional offline container smoke test override:
# MARKET_DATA_SOURCE=synthetic

# Transactional email via Resend's HTTPS API (DigitalOcean blocks outbound SMTP,
# so this is the only reliable sender on the droplet). Email sends only when
# RESEND_API_KEY is set; keep the real key only in the droplet env file.
# EMAIL_FROM must be a Resend-verified sender.
# RESEND_API_KEY=<Resend API key>
# EMAIL_FROM=Quip Network <noreply@quip.network>
# RESEND_TIMEOUT_S=10

# Admin dashboard (/admin). When set, the /admin/* endpoints require a matching
# X-Admin-Key header; unset → the dashboard is disabled (403). Keep the real key
# only in the droplet env file.
# ADMIN_API_KEY=<a long random secret>
