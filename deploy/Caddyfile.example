# RETIRED. This proxied the backend on the DigitalOcean droplet, which was
# destroyed on 2026-07-28. The backend now runs on Flux Orbit behind Flux's load
# balancer, with no Caddy; see docs/DEPLOY.md.

qtw.backend.quip.network {
	encode zstd gzip

	# Reject oversized request bodies before they're buffered (the API only takes
	# small JSON; this caps a memory/CPU DoS on the single worker).
	request_body {
		max_size 64KB
	}

	# Security headers. HSTS (Caddy terminates TLS), no MIME sniffing, deny framing,
	# trim the referrer, and don't advertise the server.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# If you add a `log` directive, delete `request>headers>Sec-Websocket-Protocol` with a
	# `format filter`: the agent websocket carries its owner token in that header, and Caddy
	# redacts only Cookie, Set-Cookie, Authorization and Proxy-Authorization by default.
	#
	# Overwrite X-Real-IP with the real peer so the backend's rate limiter can't be
	# fooled by a client-supplied X-Forwarded-For. The app reads X-Real-IP first.
	reverse_proxy 127.0.0.1:8000 {
		header_up X-Real-IP {http.request.remote.host}
	}
}
